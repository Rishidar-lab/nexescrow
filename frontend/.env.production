# Public build-time defaults for production/preview builds (no secrets).
#
# Vercel environment variables, when defined, take precedence over this file
# (process.env wins over .env.* loading). These defaults keep preview builds
# pinned to BOT Bohr testnet 968 with mainnet disabled, using the validated
# (unaudited) testnet contract.
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_DEFAULT_CHAIN_ID=968
NEXT_PUBLIC_ALLOW_MAINNET=false
NEXT_PUBLIC_ESCROW_ADDRESS_968=0x6448668ae9cbbc41617c2bd5e4f29279320a2700
NEXT_PUBLIC_DEPLOY_BLOCK_968=26178651
