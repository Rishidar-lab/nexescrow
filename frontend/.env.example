# =============================================================================
# NexEscrow frontend — chain configuration
# =============================================================================
#
# SAFETY: this build defaults to a TESTNET (BOT Chain Bohr, 968). It never
# defaults to a mainnet, and mainnets are unreachable unless
# NEXT_PUBLIC_ALLOW_MAINNET=true is set explicitly. Every write transaction
# asserts connectedChainId === selectedChainId and is blocked otherwise.
#
# Networks understood by this build:
#   3945 Nexus Testnet  NEX  https://testnet.rpc.nexus.xyz  https://testnet.explorer.nexus.xyz
#   3946 Nexus Mainnet  NEX  https://mainnet.rpc.nexus.xyz  https://explorer.nexus.xyz
#    968 BOT Bohr       BOT  https://rpc.bohr.life          https://scan.bohr.life
#    677 BOT Mainnet    BOT  https://rpc.botchain.ai        https://scan.botchain.ai
# =============================================================================

# Explicit chain selection. Leave unset to use the default below (testnet).
# Mainnet ids are ignored (fail closed to testnet) unless NEXT_PUBLIC_ALLOW_MAINNET=true.
NEXT_PUBLIC_CHAIN_ID=968

# Default used when NEXT_PUBLIC_CHAIN_ID is unset. Must be a testnet in any build
# that is not deliberately operator-configured for mainnet.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=968

# Set to "true" ONLY to enable mainnet chain selection. Never the default.
# Mainnet configuration is documented but opt-in; mainnet deployments also
# require ALLOW_MAINNET_DEPLOYMENT=true on the contracts side.
NEXT_PUBLIC_ALLOW_MAINNET=false

# Optional per-chain RPC overrides (otherwise the defaults above are used).
# NEXT_PUBLIC_RPC_URL_3945=
# NEXT_PUBLIC_RPC_URL_3946=
# NEXT_PUBLIC_RPC_URL_968=
# NEXT_PUBLIC_RPC_URL_677=

# Optional per-chain explorer overrides.
# NEXT_PUBLIC_EXPLORER_URL_3945=
# NEXT_PUBLIC_EXPLORER_URL_3946=
# NEXT_PUBLIC_EXPLORER_URL_968=
# NEXT_PUBLIC_EXPLORER_URL_677=

# Deployed NexusEscrow address PER CHAIN (from contracts/broadcast/… after deploy).
# There is deliberately no single shared address variable — a cross-chain address
# fallback would let a testnet build transact against a mainnet deployment.
NEXT_PUBLIC_ESCROW_ADDRESS_3945=
NEXT_PUBLIC_ESCROW_ADDRESS_3946=
NEXT_PUBLIC_ESCROW_ADDRESS_968=
NEXT_PUBLIC_ESCROW_ADDRESS_677=

# First block to scan for AgreementCreated logs (the deployment block). Bounds
# the client-side log scan. For a fresh testnet deployment set it to the block
# printed by the deploy script.
NEXT_PUBLIC_DEPLOY_BLOCK_3945=
NEXT_PUBLIC_DEPLOY_BLOCK_3946=
NEXT_PUBLIC_DEPLOY_BLOCK_968=
NEXT_PUBLIC_DEPLOY_BLOCK_677=

# Optional — URL of a production indexer (see ../docs/INDEXING.md). When set,
# agreement discovery and activity timelines go through it; otherwise the app
# uses bounded, chunked direct-RPC log scans.
NEXT_PUBLIC_INDEXER_URL=

# Free project ID from https://cloud.reown.com (WalletConnect Cloud).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
