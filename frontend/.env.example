# Deployed NexusEscrow contract address (from contracts/broadcast/… after deploy).
NEXT_PUBLIC_ESCROW_ADDRESS=

# Defaults to Nexus L1 mainnet (chain 3946) if unset — see src/lib/chain.ts.
# To point this build at Nexus testnet instead (chain 3945), set:
#   NEXT_PUBLIC_NEXUS_RPC_URL=https://testnet.rpc.nexus.xyz
#   NEXT_PUBLIC_NEXUS_EXPLORER_URL=https://testnet.explorer.nexus.xyz
# and update `id`/`testnet` in src/lib/chain.ts to 3945/true to match.
NEXT_PUBLIC_NEXUS_RPC_URL=
NEXT_PUBLIC_NEXUS_EXPLORER_URL=

# Optional — URL of the NexEscrow indexer (backend/). When set, the agreement
# detail page shows an on-chain activity timeline and the landing page can show
# protocol stats. Without it the dApp still works fully via direct RPC reads.
NEXT_PUBLIC_INDEXER_URL=

# Free project ID from https://cloud.reown.com (WalletConnect Cloud).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=