# Deployer key. Never commit the real .env file.
# WARNING: nexus_mainnet (see foundry.toml) is real Nexus L1 mainnet — a funded key
# here will spend real NEX and, once deployed, hold real user funds in an
# unaudited contract. Use nexus_testnet while iterating.
PRIVATE_KEY=0xyour_private_key_here

# Optional overrides — default to the deployer address if unset.
ESCROW_OWNER=
ESCROW_FEE_RECIPIENT=
