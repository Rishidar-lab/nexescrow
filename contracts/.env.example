# Deployer key (funded on Nexus L1 testnet). Never commit the real .env file.
PRIVATE_KEY=0xyour_private_key_here

# Optional overrides — default to the deployer address if unset.
ESCROW_OWNER=
ESCROW_FEE_RECIPIENT=

# Fill these in from Nexus's official docs/RPC list — not hardcoded here since
# endpoints and chain params can change between testnet phases.
NEXUS_TESTNET_RPC_URL=
NEXUS_EXPLORER_API_URL=
NEXUS_EXPLORER_API_KEY=
