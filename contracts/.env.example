# Deployer key. Never commit a real key; use a burner key funded with TESTNET tokens.
PRIVATE_KEY=0xyour_private_key_here

# Optional overrides — default to the deployer address if unset.
ESCROW_OWNER=
ESCROW_FEE_RECIPIENT=

# Mainnet deployments (BOT 677 / Nexus 3946) are refused by the deploy script
# unless this is exactly "true". Never the default. Only set after independent
# security review. Mainnet configuration is documented but opt-in.
ALLOW_MAINNET_DEPLOYMENT=false
